<?php

/**
 * @file
 * Module Romus Commerce - Fonctionnalités e-commerce personnalisées.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\commerce_order\Entity\OrderInterface;

/**
 * Implements hook_help().
 */
function romus_commerce_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.romus_commerce':
      return '<p>' . t('Module e-commerce personnalisé pour Romus : gestion panier, commandes et paiements.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function romus_commerce_theme($existing, $type, $theme, $path) {
  return [
    'commerce_cart_block' => [
      'template' => 'commerce-cart-block',
      'variables' => [
        'count' => 0,
        'content' => [],
        'url' => NULL,
      ],
    ],
    'commerce_checkout_form' => [
      'template' => 'commerce-checkout-form',
      'render element' => 'form',
    ],
  ];
}

/**
 * Implements hook_form_alter().
 */
function romus_commerce_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Personnalisation du formulaire de checkout
  if (strpos($form_id, 'commerce_checkout_flow') === 0) {
    // Ajout de classes CSS personnalisées
    $form['#attributes']['class'][] = 'romus-checkout-form';
    
    // Personnalisation des labels
    if (isset($form['shipping_information'])) {
      $form['shipping_information']['#title'] = t('Informations de livraison');
    }
    
    if (isset($form['payment_information'])) {
      $form['payment_information']['#title'] = t('Informations de paiement');
    }
  }
  
  // Personnalisation du formulaire d'ajout au panier
  if (strpos($form_id, 'commerce_order_item_add_to_cart_form') === 0) {
    $form['actions']['submit']['#value'] = t('Ajouter au panier');
    $form['actions']['submit']['#attributes']['class'][] = 'btn-romus-primary';
  }
}

/**
 * Implements hook_commerce_order_presave().
 */
function romus_commerce_commerce_order_presave(OrderInterface $order) {
  // Logique personnalisée avant sauvegarde des commandes
  if ($order->getState()->getId() == 'draft') {
    // Calculs personnalisés, remises, etc.
  }
}

/**
 * Implements hook_mail().
 */
function romus_commerce_mail($key, &$message, $params) {
  switch ($key) {
    case 'order_confirmation':
      $message['subject'] = t('Confirmation de commande Romus - @order_number', [
        '@order_number' => $params['order_number']
      ]);
      $message['body'][] = $params['message'];
      break;
  }
}

